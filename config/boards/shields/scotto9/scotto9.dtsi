// scotto9.dtsi - Scotto9 shield for nice!nano v2
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <2>;
        rows = <5>;
        /* 5x2 macropad: rows = top→bottom; columns = left→right */
        map = <
            RC(0,0) RC(0,1)
            RC(1,0) RC(1,1)
            RC(2,0) RC(2,1)
            RC(3,0) RC(3,1)
            RC(4,0) RC(4,1)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        wakeup-source;
        
        diode-direction = "col2row";

        // Columns (left → right): 020, 022
        col-gpios
            = <&gpio0 20 GPIO_ACTIVE_HIGH>   // Pin labeled 020 (C0)
            , <&gpio0 22 GPIO_ACTIVE_HIGH>   // Pin labeled 022 (C1)
            ;

        // Rows (top → bottom): 029, 002, 115, 113
        row-gpios
            = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Pin labeled 029 (R0)
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Pin labeled 002 (R1)
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Pin labeled 115 (R2)
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Pin labeled 113 (R3)
            ;
    };

    btclr_kscan: btclr_button {
        compatible = "zmk,kscan-gpio";
        label = "BTCLR";
        input-gpios = <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // Pin labeled 100 to GND
        wakeup-source;
    };

    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <2>;

        matrix0: macropad_matrix {
            kscan = <&kscan0>;
            row-offset = <0>;
            col-offset = <0>;
        };

        btclr: btclr_direct {
            kscan = <&btclr_kscan>;
            row-offset = <4>;
            col-offset = <0>;
        };
    };
};
