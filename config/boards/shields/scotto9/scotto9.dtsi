// scotto9.dtsi - Scotto9 shield for nice!nano v2
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <2>;
        /* 2x4 macropad: rows = top,bottom; columns = left→right */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        
        diode-direction = "col2row";
        
        // Columns (left → right): 029, 002, 115, 113
        col-gpios
            = <&gpio0 29 GPIO_ACTIVE_HIGH>   // Pin labeled 029  (C0 - leftmost)
            , <&gpio0 2  GPIO_ACTIVE_HIGH>   // Pin labeled 002  (C1)
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   // Pin labeled 115  (C2)
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   // Pin labeled 113  (C3 - rightmost)
            ;

        // Rows (top → bottom): 020, 022
        row-gpios
            = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Pin labeled 020 (top row)
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Pin labeled 022 (bottom row)
            ;
    };
};
