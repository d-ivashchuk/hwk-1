#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        cmd_1: cmd_1_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_1";
            #binding-cells = <0>;
            bindings = <&kp N1>;
        };

        cmd_2: cmd_2_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_2";
            #binding-cells = <0>;
            bindings = <&kp N2>;
        };

        cmd_3: cmd_3_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_3";
            #binding-cells = <0>;
            bindings = <&kp N3>;
        };

        cmd_4: cmd_4_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_4";
            #binding-cells = <0>;
            bindings = <&kp N4>;
        };

        cmd_5: cmd_5_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_5";
            #binding-cells = <0>;
            bindings = <&kp N5>;
        };

        cmd_6: cmd_6_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_6";
            #binding-cells = <0>;
            bindings = <&kp N6>;
        };

        cmd_7: cmd_7_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_7";
            #binding-cells = <0>;
            bindings = <&kp N7>;
        };

        cmd_8: cmd_8_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_8";
            #binding-cells = <0>;
            bindings = <&kp N8>;
        };

        cmd_9: cmd_9_macro {
            compatible = "zmk,behavior-macro";
            label = "CMD_9";
            #binding-cells = <0>;
            bindings = <&kp N9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Matrix rows 0–3, columns 0–1
                // Physical layout rotated 180° so that:
                // Top row keys send 1 2 3 4, bottom row 5 6 7 8.
                &cmd_8  &cmd_4
                &cmd_7  &cmd_3
                &cmd_6  &cmd_2
                &cmd_5  &cmd_1
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear_combo {
            timeout-ms = <50>;
            key-positions = <0 1 7>;
            layers = <0>;
            bindings = <&bt BT_CLR>;
        };
    };
};
